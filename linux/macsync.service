[Unit]
Description=MacSync rsync snapshot daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# config.toml, state.toml, and logs/ live next to this binary
ExecStart=%h/.local/bin/macsync
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
# Runs as the user who owns this user unit (no User= line).

[Install]
WantedBy=default.target
